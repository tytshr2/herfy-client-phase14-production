# ChatGPT / OpenAI Configuration
# احصل على مفتاحك من: https://platform.openai.com/api-keys

OPENAI_CLIENT_ID=your_client_id_here
OPENAI_API_KEY=your_api_key_here
OPENAI_ORG_ID=your_org_id_here

# API Endpoints
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_AUTH_URL=https://auth.openai.com

# Xcode Signing
DEVELOPMENT_TEAM=YOUR_TEAM_ID
BUNDLE_IDENTIFIER=com.example.herfyclient

# Environment
ENVIRONMENT=development
DEBUG_MODE=true

# Security
ENABLE_SSL_PINNING=true
REQUIRE_BIOMETRIC_AUTH=false
